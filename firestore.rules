rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isSuperAdmin() {
      return isSignedIn() && (getUserData().role == 'superadmin' || getUserData().role == 'super-admin');
    }

    function isAdmin() {
      return isSuperAdmin() || hasRole('admin');
    }

    function isCounselor() {
      return hasRole('counselor');
    }

    function isStaff() {
      return isAdmin() || isCounselor();
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      // Public student registration. Staff creation.
      // Creating Admin/Super Admin accounts strictly requires Super Admin authority.
      allow create: if isSignedIn() && request.auth.uid == userId && (
        request.resource.data.role == 'student' ||
        (request.resource.data.role == 'counselor' && isAdmin()) ||
        ((request.resource.data.role == 'admin' || request.resource.data.role == 'superadmin' || request.resource.data.role == 'super-admin') && isSuperAdmin())
      );
      // Profile updates. Changing role or modifying Admin profiles requires Super Admin.
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) ||
                      isSuperAdmin() ||
                      (isAdmin() && resource.data.role != 'admin' && resource.data.role != 'superadmin' && resource.data.role != 'super-admin');
      // Deleting Admin accounts strictly requires Super Admin. Regular Admins can manage non-admin users.
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.role != 'admin' && resource.data.role != 'superadmin' && resource.data.role != 'super-admin');
    }

    // Applications collection
    match /applications/{appId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if true; // Allows prospective international students to submit application profile
      allow update: if isStaff() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Document credentials collection
    match /documents/{docId} {
      allow read: if isStaff() || (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if true; // Allows prospective international students to attach documents
      allow update: if isStaff() || (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Public inquiries / Contact form messages
    match /inquiries/{inquiryId} {
      allow read: if isStaff();
      allow create: if true; // Public contact form submissions
      allow update, delete: if isStaff();
    }

    // Appointments
    match /appointments/{apptId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isStaff() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Saved Universities (Bookmarks per student)
    match /savedUniversities/{userId} {
      allow read, write: if isOwner(userId) || isStaff();
    }

    // Public University catalog
    match /universities/{uniId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public Courses catalog
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public Scholarships
    match /scholarships/{scholarshipId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
