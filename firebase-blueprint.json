{
  "entities": {
    "Application": {
      "description": "Student admissions application dossiers submitted to Myers Global Pathways / Study in India",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "trackingId": { "type": "string" },
          "fullName": { "type": "string" },
          "email": { "type": "string" },
          "whatsapp": { "type": "string" },
          "currentCountry": { "type": "string" },
          "intendedDegree": { "type": "string" },
          "desiredMajor": { "type": "string" },
          "budget": { "type": "string" },
          "status": { "type": "string" },
          "stageIndex": { "type": "number" },
          "priority": { "type": "string" },
          "adminNotes": { "type": "string" },
          "universityMatch": { "type": "string" },
          "submittedAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "documents": {
            "type": "array",
            "items": { "type": "object" }
          }
        },
        "required": ["trackingId", "fullName", "email", "intendedDegree", "desiredMajor", "status"]
      },
      "security": {
        "read": "public",
        "write": "public"
      }
    },
    "Enquiry": {
      "description": "Student admission inquiries, leads, and contact submissions",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "fullName": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "country": { "type": "string" },
          "interestedProgram": { "type": "string" },
          "message": { "type": "string" },
          "createdAt": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": ["fullName", "email", "message"]
      },
      "security": {
        "read": "public",
        "write": "public"
      }
    },
    "BlogPost": {
      "description": "Student Life in India blog articles, campus event updates, cultural guides, and international student success stories",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "excerpt": { "type": "string" },
          "category": { "type": "string" },
          "author": { "type": "object" },
          "publishedAt": { "type": "string" },
          "readTime": { "type": "string" },
          "coverImage": { "type": "string" },
          "coverImageAlt": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "sections": { "type": "array", "items": { "type": "object" } },
          "featured": { "type": "boolean" },
          "likes": { "type": "number" }
        },
        "required": ["title", "excerpt", "category"]
      },
      "security": {
        "read": "public",
        "write": "public"
      }
    },
    "StudentStorySubmission": {
      "description": "Submissions from current international students and alumni sharing experiences, events, and advice",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "studentName": { "type": "string" },
          "email": { "type": "string" },
          "whatsapp": { "type": "string" },
          "country": { "type": "string" },
          "university": { "type": "string" },
          "program": { "type": "string" },
          "category": { "type": "string" },
          "storyTitle": { "type": "string" },
          "storyContent": { "type": "string" },
          "submittedAt": { "type": "string" }
        },
        "required": ["studentName", "email", "storyTitle", "storyContent"]
      },
      "security": {
        "read": "public",
        "write": "public"
      }
    },
    "NewsletterSubscription": {
      "description": "Email subscribers for the Student Life in India weekly updates, campus events, and cultural guides",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string" },
          "frequency": { "type": "string" },
          "interest": { "type": "string" },
          "source": { "type": "string" },
          "subscribedAt": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": ["email", "subscribedAt"]
      },
      "security": {
        "read": "public",
        "write": "public"
      }
    }
  }
}
