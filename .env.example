# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_WHATSAPP_NUMBER: Optional official WhatsApp international phone number (e.g., 919201330946).
# If not configured, the website gracefully displays the official configuration state.
VITE_WHATSAPP_NUMBER=""

# Outbound Email Notification Configuration
# Primary: Email dispatch operates securely via Google Workspace OAuth 2.0 / Gmail API from admissions@myersglobalpathways.com.
# Optional Server-Side SMTP Fallback (used automatically via Nodemailer if Google Workspace OAuth is not connected):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Myers Global Pathways Admissions <admissions@myersglobalpathways.com>"
